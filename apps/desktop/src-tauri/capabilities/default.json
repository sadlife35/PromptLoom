{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capabilities: shell plugin, global shortcut, HUD window ops.",
  "windows": ["settings", "hud"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "shell:default",
    "global-shortcut:default",
    "dialog:default"
  ]
}
