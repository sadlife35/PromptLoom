{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptLoom",
  "version": "0.1.0",
  "identifier": "com.promptloom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "PromptLoom Settings",
        "width": 720,
        "height": 540,
        "resizable": true,
        "visible": true,
        "url": "index.html"
      },
      {
        "label": "hud",
        "title": "PromptLoom HUD",
        "width": 220,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "visible": false,
        "url": "hud.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "PromptLoom"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
