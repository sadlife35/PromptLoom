{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jot",
  "version": "0.1.0",
  "identifier": "com.promptloom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Jot Settings",
        "width": 720,
        "height": 540,
        "resizable": true,
        "visible": true,
        "url": "index.html"
      },
      {
        "label": "hud",
        "title": "Jot HUD",
        "width": 160,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "visible": false,
        "url": "hud.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Jot — starting…"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../../../models/manifest.json"],
    "publisher": "Jot contributors",
    "shortDescription": "Local-only Windows dictation",
    "longDescription": "Jot is a local Windows dictation prototype. Hold a hotkey, speak, release — text is transcribed locally with whisper.cpp and pasted into the window you were focused on. No account, no cloud, no telemetry.",
    "copyright": "Copyright 2026 Jot contributors",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com"
    }
  },
  "plugins": {}
}
